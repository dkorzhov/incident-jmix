<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        logicalFilePath="com/company/incidentjmix/liquibase/changelog/030-incident.xml">

    <!-- Incident table (ADR-001). Business invariants live in services, not DB constraints. -->

    <changeSet id="1" author="incident-jmix" context="!cuba">
        <createTable tableName="INC_INCIDENT">
            <column name="ID" type="varchar(20)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="TITLE" type="varchar(120)">
                <constraints nullable="false"/>
            </column>
            <column name="DESCRIPTION" type="varchar(2000)"/>
            <column name="CATEGORY" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="PRIORITY" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="STATUS" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="ASSIGNEE_ID" type="int"/>
            <column name="RESOLUTION" type="varchar(2000)"/>
            <column name="CREATED_AT" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="UPDATED_AT" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2" author="incident-jmix" context="!cuba">
        <createIndex indexName="IDX_INC_INCIDENT_ON_STATUS" tableName="INC_INCIDENT">
            <column name="STATUS"/>
        </createIndex>
        <createIndex indexName="IDX_INC_INCIDENT_ON_PRIORITY" tableName="INC_INCIDENT">
            <column name="PRIORITY"/>
        </createIndex>
        <createIndex indexName="IDX_INC_INCIDENT_ON_CREATED_AT" tableName="INC_INCIDENT">
            <column name="CREATED_AT"/>
        </createIndex>
    </changeSet>

    <changeSet id="3" author="incident-jmix" context="!cuba">
        <addForeignKeyConstraint baseTableName="INC_INCIDENT" baseColumnNames="ASSIGNEE_ID"
                                 constraintName="FK_INC_INCIDENT_ON_ASSIGNEE"
                                 referencedTableName="INC_APP_USER" referencedColumnNames="ID"/>
    </changeSet>

</databaseChangeLog>
